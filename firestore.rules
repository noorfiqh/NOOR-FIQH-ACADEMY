rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == 'noorfiqhaca@gmail.com' || 
         request.auth.token.admin == true);
    }

    // User profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() ? (request.resource.data.userId == request.auth.uid || isAdmin()) : true;
      allow update, delete: if isAdmin();
    }

    // Fatwas
    match /fatwas/{fatwaId} {
      allow read: if resource.data.isPrivate == false || (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if true; // Allows public anonymous or registered fatwa questions
      allow update, delete: if isAdmin();
    }

    // Courses, Books, Live Classes, Certificates, Reviews, Settings
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /books/{bookId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /live_classes/{classId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /certificates/{certId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if isAuthenticated() || isAdmin();
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}

